# =====================================================================
# StudentFo — environment variables
# Copy ke .env.local lalu isi. SEMUA opsional saat development:
# kalau kosong, app otomatis jalan pakai in-memory seed repository.
# Lihat src/lib/env.ts (validasi Zod) dan src/lib/data/index.ts (pemilih repo).
# =====================================================================

# --- Supabase (frontend, aman diekspos ke browser; dilindungi RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role: HANYA server-side (scraper & admin action) ---
# JANGAN pernah diprefix NEXT_PUBLIC_. Key ini bypass RLS by design (§7 blueprint).
SUPABASE_SERVICE_ROLE_KEY=

# --- Base URL untuk metadata/sitemap/OG image ---
# JUGA dipakai membangun tautan konfirmasi email & callback OAuth. Salah isi
# di produksi = tautan di email mengarah ke localhost. Nilai ini harus
# terdaftar di Supabase → Authentication → URL Configuration → Redirect URLs
# sebagai `<NEXT_PUBLIC_SITE_URL>/auth/callback`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data pipeline (dipakai skrip Python di /pipeline, bukan oleh Next.js) ---
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
