# =====================================================================
# StudentFo — environment variables
# Copy ke .env.local lalu isi. SEMUA opsional saat development:
# kalau kosong, app otomatis jalan pakai in-memory seed repository.
# Lihat src/lib/env.ts (validasi Zod) dan src/lib/data/index.ts (pemilih repo).
# =====================================================================

# --- Supabase (frontend, aman diekspos ke browser; dilindungi RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role: HANYA server-side (scraper & admin action) ---
# JANGAN pernah diprefix NEXT_PUBLIC_. Key ini bypass RLS by design (§7 blueprint).
SUPABASE_SERVICE_ROLE_KEY=

# --- Mode demo (dipakai hanya saat kredensial Supabase kosong) ---
# Build produksi (`next start`) tanpa Supabase akan MENOLAK jalan, supaya
# situs publik tidak diam-diam menampilkan data fiktif. Isi `true` hanya
# untuk deploy yang memang situs demo/pratinjau.
ALLOW_DEMO_IN_PRODUCTION=false
# Penanda tangan cookie akun demo (min. 32 karakter). Opsional di lokal;
# WAJIB kalau demo jalan di lebih dari satu instance (Vercel), supaya sesi
# yang dibuat instance A dikenali instance B. Buat: `openssl rand -hex 32`
DEMO_SESSION_SECRET=
# Host yang boleh menyajikan akun demo di produksi (dipisah koma, tanpa skema),
# mis. `demo.studentfo.id`. WAJIB diisi bila ALLOW_DEMO_IN_PRODUCTION=true:
# kosong = akun demo ditolak. Ini penjaga kalau flag di atas salah menyala di
# deploy bernama domain sungguhan. Header Host harus asli (jangan di-rewrite proxy).
DEMO_ALLOWED_HOSTS=
# Kunci tautan khusus persona Admin demo (min. 16 karakter): `/demo?akses=<kunci>`.
# Kosong = persona Admin tidak tersedia di produksi (di `npm run dev` selalu tersedia).
DEMO_ADMIN_KEY=

# --- Dokumen hukum (/privacy-policy, /cookie-policy, /terms — ADR-060) ---
# Selama salah satunya kosong, dokumen berlabel DRAF. Isi hanya setelah pemilik
# meninjau isinya bersama penasihat hukum:
#   LEGAL_OPERATOR_NAME  nama resmi pengelola/pengendali data, mis. "PT Contoh
#                        Edukasi Indonesia" atau nama lengkap perorangan
#   PRIVACY_CONTACT_EMAIL kotak masuk yang DIPANTAU: UU PDP mewajibkan tanggapan
#                        atas permintaan data pribadi paling lambat 3 × 24 jam
#   *_EFFECTIVE_DATE     tanggal berlaku (YYYY-MM-DD). Kebijakan cookie memakai
#                        tanggal Kebijakan privasi (ia lampirannya).
LEGAL_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_EFFECTIVE_DATE=
TERMS_EFFECTIVE_DATE=

# --- Pembatas laju (masuk, daftar, lupa sandi, /submit) ---
# Kunci HMAC untuk ember penghitung (IP tidak disimpan mentah). Opsional:
# tanpa ini dipakai SUPABASE_SERVICE_ROLE_KEY. Harus sama di semua instance.
# PENTING: batas per-IP hanya berarti kalau proxy terdepan (Vercel/Cloudflare/
# Nginx) MENIMPA header x-forwarded-for — lihat src/lib/rate-limit.ts.
# Kunci yang sama dipakai untuk hash pengunjung harian analitik acara (ADR-043).
RATE_LIMIT_SECRET=
# Opsional: header IP satu-nilai yang DITULIS platform (mis. cf-connecting-ip di
# belakang Cloudflare). Kosongkan kalau tidak yakin — header ini bisa dikarang
# klien di hosting yang tidak menimpanya.
CLIENT_IP_HEADER=

# --- Cloudflare Turnstile (CAPTCHA di /submit, daftar akun, lupa sandi, kirim ulang konfirmasi) — isi berpasangan, atau kosongkan keduanya ---
# Diverifikasi server StudentFo sendiri: JANGAN aktifkan CAPTCHA bawaan Supabase Auth (ADR-056).
# Dashboard Cloudflare → Turnstile → Add site. Kunci uji resmi untuk staging:
#   selalu lolos: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   selalu gagal: 2x00000000000000000000AB / 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Endpoint mesin /api/cron/* (bot pengirim pengingat tenggat, ADR-051) ---
# Bearer token, minimal 32 karakter: `openssl rand -hex 32`. Kosong = endpoint
# menolak semua permintaan. Simpan HANYA di hosting + di bot pemanggil.
CRON_SECRET=

# --- Base URL untuk metadata/sitemap/OG image ---
# JUGA dipakai membangun tautan konfirmasi email & callback OAuth. Salah isi
# di produksi = tautan di email mengarah ke localhost. Nilai ini harus
# terdaftar di Supabase → Authentication → URL Configuration → Redirect URLs
# sebagai `<NEXT_PUBLIC_SITE_URL>/auth/callback`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data pipeline (dipakai skrip Python di /pipeline, bukan oleh Next.js) ---
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
