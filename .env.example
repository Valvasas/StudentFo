# =====================================================================
# StudentFo — environment variables
# Copy ke .env.local lalu isi. SEMUA opsional saat development:
# kalau kosong, app otomatis jalan pakai in-memory seed repository.
# Lihat src/lib/env.ts (validasi Zod) dan src/lib/data/index.ts (pemilih repo).
# =====================================================================

# --- Supabase (frontend, aman diekspos ke browser; dilindungi RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role: HANYA server-side (scraper & admin action) ---
# JANGAN pernah diprefix NEXT_PUBLIC_. Key ini bypass RLS by design (§7 blueprint).
SUPABASE_SERVICE_ROLE_KEY=

# --- Mode demo (dipakai hanya saat kredensial Supabase kosong) ---
# Build produksi (`next start`) tanpa Supabase akan MENOLAK jalan, supaya
# situs publik tidak diam-diam menampilkan data fiktif. Isi `true` hanya
# untuk deploy yang memang situs demo/pratinjau.
ALLOW_DEMO_IN_PRODUCTION=false
# Penanda tangan cookie akun demo (min. 32 karakter). Opsional di lokal;
# WAJIB kalau demo jalan di lebih dari satu instance (Vercel), supaya sesi
# yang dibuat instance A dikenali instance B. Buat: `openssl rand -hex 32`
DEMO_SESSION_SECRET=

# --- Pembatas laju (masuk, daftar, lupa sandi, /submit) ---
# Kunci HMAC untuk ember penghitung (IP tidak disimpan mentah). Opsional:
# tanpa ini dipakai SUPABASE_SERVICE_ROLE_KEY. Harus sama di semua instance.
# PENTING: batas per-IP hanya berarti kalau proxy terdepan (Vercel/Cloudflare/
# Nginx) MENIMPA header x-forwarded-for — lihat src/lib/rate-limit.ts.
RATE_LIMIT_SECRET=

# --- Cloudflare Turnstile (CAPTCHA di /submit) — isi berpasangan, atau kosongkan keduanya ---
# Dashboard Cloudflare → Turnstile → Add site. Kunci uji resmi untuk staging:
#   selalu lolos: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   selalu gagal: 2x00000000000000000000AB / 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Base URL untuk metadata/sitemap/OG image ---
# JUGA dipakai membangun tautan konfirmasi email & callback OAuth. Salah isi
# di produksi = tautan di email mengarah ke localhost. Nilai ini harus
# terdaftar di Supabase → Authentication → URL Configuration → Redirect URLs
# sebagai `<NEXT_PUBLIC_SITE_URL>/auth/callback`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data pipeline (dipakai skrip Python di /pipeline, bukan oleh Next.js) ---
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
