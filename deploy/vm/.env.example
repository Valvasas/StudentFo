# Variabel INTERPOLASI compose (bukan rahasia). deploy.sh menulis berkas .env
# ini sendiri di setiap deploy — tidak perlu diisi tangan, kecuali menjalankan
# `docker compose` manual sebelum deploy pertama.
IMAGE=ghcr.io/valvasas/studentfo
IMAGE_TAG=
# Host dari NEXT_PUBLIC_SITE_URL, tanpa https:// (mis. studentfo.com atau
# studentfo-xyz.southeastasia.cloudapp.azure.com)
SITE_HOST=
# Sesuaikan RAM VM: 1 GB → 600m/448, 2 GB → 1200m/896
APP_MEM_LIMIT=700m
APP_HEAP_MB=512
