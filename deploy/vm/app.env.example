# Rahasia & konfigurasi RUNTIME aplikasi di VM. Salin ke /opt/studentfo/app.env,
# isi nilainya, lalu `chmod 600 app.env`. JANGAN commit berkas yang sudah berisi.
# Sumber tiap nilai & catatannya: docs/deploy-vm.md § Rahasia.
#
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SITE_URL
# TIDAK ada di sini: dibekukan ke image saat build (repository variables
# GitHub, dipakai deploy-vm.yml). Mengisinya di sini tidak mengubah apa pun.

# --- Wajib ---
# Supabase → Project Settings → API keys (sb_secret_…). Tanpa ini panel admin,
# hapus akun, dan pengerja cron gagal.
SUPABASE_SERVICE_ROLE_KEY=
# openssl rand -hex 32 — nilai baru boleh (bucket batas laju & hash pengunjung reset)
RATE_LIMIT_SECRET=
# openssl rand -hex 32 — HARUS sama dengan secret GitHub Actions CRON_SECRET
CRON_SECRET=

# --- CAPTCHA (isi berpasangan; tambahkan hostname baru di dasbor Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email pengingat (isi KETIGANYA atau kosongkan ketiganya) ---
RESEND_API_KEY=
EMAIL_FROM=
# openssl rand -hex 32. Nilai baru = tautan berhenti-langganan di email lama tidak berlaku.
EMAIL_LINK_SECRET=

# --- Opsional ---
# Slack/Discord incoming webhook (https)
ERROR_ALERT_WEBHOOK_URL=
# Tanpa empat ini Kebijakan privasi & S&K tampil berlabel DRAF.
LEGAL_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_EFFECTIVE_DATE=
TERMS_EFFECTIVE_DATE=

# --- KOSONGKAN di VM ini ---
# Di belakang Caddy saja IP klien diambil dari X-Forwarded-For yang ditulis
# Caddy. Mengisi cf-connecting-ip TANPA Cloudflare di depan = klien bisa
# memalsukan IP-nya dan lolos batas laju.
CLIENT_IP_HEADER=
# Mode demo TIDAK BOLEH menyala di produksi (health check menolaknya).
# ALLOW_DEMO_IN_PRODUCTION, DEMO_ALLOWED_HOSTS, DEMO_ADMIN_KEY, DEMO_SESSION_SECRET
# sengaja tidak dicantumkan — jangan ditambahkan.
