# =====================================================================
# StudentFo — env PRODUKSI untuk deploy/docker-compose.yml
# Salin:  cp deploy/env.example deploy/.env   lalu isi, lalu:
#         chmod 600 deploy/.env
# Berkas deploy/.env TIDAK di-commit (.gitignore) dan TIDAK ikut ke image
# (.dockerignore). Validasi nilainya: src/lib/env.ts. Panduan: docs/panduan-hosting.md
# =====================================================================

# --- Dibekukan saat BUILD (ikut ke bundle peramban = publik, bukan rahasia) ---
# Ubah salah satunya = wajib build ulang: docker compose ... up -d --build
#
# Domain final, persis seperti di Supabase → Authentication → URL Configuration → Site URL.
# Tanpa garis miring di akhir. Salah isi = tautan email konfirmasi menunjuk ke tempat lain.
NEXT_PUBLIC_SITE_URL=https://studentfo.id
# Supabase → Project Settings → API Keys. Kunci publishable (sb_publishable_…);
# kunci `anon` lama berhenti berfungsi akhir 2026.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Rahasia RUNTIME (hanya server; ganti cukup dengan restart) ---
# Kunci secret (sb_secret_…). Mem-bypass RLS: jangan pernah beri awalan
# NEXT_PUBLIC_, jangan tempel di chat/screenshot, ganti bila pernah bocor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# openssl rand -hex 32  — kunci HMAC ember pembatas laju & hash pengunjung.
RATE_LIMIT_SECRET=
# Cloudflare → Turnstile → widget untuk domainmu. Isi berpasangan atau kosongkan keduanya.
# JANGAN aktifkan CAPTCHA bawaan Supabase Auth — server kita yang memverifikasi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Aman HANYA karena aplikasi tidak punya port publik (lihat docker-compose.yml):
# setiap permintaan lewat Cloudflare, yang menimpa header ini dengan IP asli.
CLIENT_IP_HEADER=cf-connecting-ip
# Bot pengirim pengingat (ADR-051). Kosong = endpoint /api/cron/* menolak semua.
# Isi (openssl rand -hex 32) hanya kalau bot-nya sudah ada.
CRON_SECRET=

# --- Kebijakan privasi ---
# Selama kosong, /privacy-policy berlabel DRAF. Isi HANYA setelah naskahnya
# ditinjau (disarankan bersama penasihat hukum). Tanggal: YYYY-MM-DD.
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_EFFECTIVE_DATE=

# --- Mode demo: biarkan KOSONG di produksi ---
# Tanpa Supabase, server produksi menolak jalan; nilai `true` di sini justru
# membuatnya menyajikan data fiktif. /api/health melaporkan dataMode untuk
# menangkap kesalahan ini.
ALLOW_DEMO_IN_PRODUCTION=
DEMO_SESSION_SECRET=
DEMO_ALLOWED_HOSTS=
DEMO_ADMIN_KEY=
